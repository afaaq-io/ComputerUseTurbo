  "keywords": [
    "mcp",
    "model-context-protocol",
    "computer-use",
    "ai-agents",
    "desktop-automation",
    "accessibility",
    "codex"
  ],
  "homepage": "https://github.com/afaaq-io/ComputerUseTurbo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afaaq-io/ComputerUseTurbo.git",
    "directory": "server"
  },
  "bugs": "https://github.com/afaaq-io/ComputerUseTurbo/issues",
  "license": "MIT",
  "author": "afaaq.io",
  "type": "module",
  "bin": {
    "computer-use-turbo": "src/server.mjs"
  },
  "main": "src/server.mjs",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test",
    "prepack": "cp ../README.md ../LICENSE .",
    "postpack": "rm -f README.md LICENSE"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
